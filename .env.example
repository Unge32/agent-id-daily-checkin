# Environment variables for scripts/deploy.js, scripts/verify.js and
# scripts/checkin-test.js. Copy this file to `.env` and fill it in — but
# NOTE: these scripts read from the shell environment, not from `.env`
# directly. Use e.g. `PRIVATE_KEY=0x... node scripts/deploy.js`.
#
# PRIVATE_KEY: the THROWAWAY TESTNET wallet used to deploy and test.
#   - Fund it with testnet BNB (tBNB) from https://testnet.bnbchain.org/faucet-smart
#   - NEVER use a mainnet key, NEVER use Angga's wallets, NEVER commit this.
# BSC_TESTNET_RPC: optional override for the BNB testnet RPC endpoint.
# BSCSCAN_API_KEY: free key from https://testnet.bscscan.com (for verify.js).
# AGENT_ID_REGISTRY: optional. If set, deploy.js points the check-in contract
#   at this registry and skips the mock. On mainnet this must be the real
#   Agent ID contract: 0x60b9262456de011f7d15a54cdd8c48baaa8b022f
PRIVATE_KEY=0x...
BSC_TESTNET_RPC=https://data-seed-prebsc-1-s1.binance.org:8545/
BSCSCAN_API_KEY=
AGENT_ID_REGISTRY=
